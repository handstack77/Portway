<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <VisualStudioVersion Condition="'$(VisualStudioVersion)' == ''">18.0</VisualStudioVersion>
    <VSToolsPath Condition="'$(VSToolsPath)' == ''">$(MSBuildExtensionsPath32)/Microsoft/VisualStudio/v$(VisualStudioVersion)</VSToolsPath>
    <NodejsTargetsPath>$(VSToolsPath)/Node.js Tools/Microsoft.NodejsToolsV2.targets</NodejsTargetsPath>
  </PropertyGroup>
  <Import Project="$(MSBuildExtensionsPath)/$(MSBuildToolsVersion)/Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)/$(MSBuildToolsVersion)/Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectGuid>{17F3CDE8-A410-4FB1-9DDA-642847435758}</ProjectGuid>
    <ProjectHome>.</ProjectHome>
    <StartupFile>src/index.js</StartupFile>
    <StartWebBrowser>false</StartWebBrowser>
    <WorkingDirectory>.</WorkingDirectory>
    <OutputPath>.</OutputPath>
    <ProjectTypeGuids>{3AF33F2E-1136-4D97-BBB7-1795711AC8B8};{9092AA53-FB77-4645-B42D-1CCCA6BD08BD}</ProjectTypeGuids>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="src/index.js" />
    <Content Include="package.json" />
    <Content Include="package-lock.json" />
    <Content Include="README.md" />
    <Content Include="docs/**/*" />
    <Content Include="jobs/**/*" />
    <None Include="Build.targets" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="docs\images\" />
    <Folder Include="src\" />
    <Folder Include="docs\" />
    <Folder Include="jobs\" />
  </ItemGroup>
  <Import Project="$(NodejsTargetsPath)" Condition="Exists('$(NodejsTargetsPath)')" />
  <!-- Node.js Tools가 없는 CLI 환경에서도 npm 명령으로 프로젝트를 검사합니다. -->
  <Import Project="Build.targets" Condition="!Exists('$(NodejsTargetsPath)')" />
  <Target Name="ValidateNodeSource" BeforeTargets="CoreCompile" Condition="Exists('$(NodejsTargetsPath)')">
    <Exec Command="npm run build" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>
  <!-- .NET 솔루션 테스트에서 Node 콘솔 프로젝트는 VSTest 실행을 건너뜁니다. -->
  <Target Name="VSTest" />
</Project>